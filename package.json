{
  "name": "symphony-demo",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@9.15.4",
  "scripts": {
    "dev": "pnpm --parallel --filter frontend --filter mastra-agent dev",
    "dev:frontend": "pnpm --filter frontend dev",
    "dev:agent": "pnpm --filter mastra-agent dev",
    "build": "pnpm --recursive build",
    "typecheck": "pnpm --recursive typecheck",
    "lint": "pnpm --recursive lint",
    "test": "pnpm --recursive test",
    "audit": "pnpm audit"
  },
  "devDependencies": {
    "@eslint/js": "^9.28.0",
    "eslint": "^9.28.0",
    "typescript": "^5.8.3",
    "typescript-eslint": "8.58.0"
  },
  "pnpm": {
    "overrides": {
      "@typescript-eslint/eslint-plugin": "8.58.0",
      "@typescript-eslint/parser": "8.58.0",
      "@typescript-eslint/project-service": "8.58.0",
      "@typescript-eslint/scope-manager": "8.58.0",
      "@typescript-eslint/tsconfig-utils": "8.58.0",
      "@typescript-eslint/type-utils": "8.58.0",
      "@typescript-eslint/types": "8.58.0",
      "@typescript-eslint/typescript-estree": "8.58.0",
      "@typescript-eslint/utils": "8.58.0",
      "@typescript-eslint/visitor-keys": "8.58.0",
      "@clack/core>fast-wrap-ansi": "0.2.0",
      "@clack/prompts>fast-wrap-ansi": "0.2.0",
      "@mastra/core>lru-cache": "11.4.0",
      "@mastra/deployer>local-pkg": "1.1.2",
      "mastra>local-pkg": "1.1.2",
      "mastra>posthog-node": "5.33.7",
      "@ai-sdk/react": "2.0.180",
      "@types/react": "19.2.10",
      "ai": "5.0.178",
      "browserslist>electron-to-chromium": "1.5.350",
      "chat": "4.28.1",
      "hono": "4.12.18"
    }
  }
}
